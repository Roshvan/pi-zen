{
	"name": "pi-zen",
	"version": "0.2.0",
	"description": "A quiet Pi TUI on one switch: clear turn markers, a rail editor, compact tool calls, and restrained reasoning",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Roshvan/pi-zen.git"
	},
	"bugs": {
		"url": "https://github.com/Roshvan/pi-zen/issues"
	},
	"homepage": "https://github.com/Roshvan/pi-zen#readme",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"coding-agent",
		"tui",
		"minimal",
		"zen"
	],
	"files": [
		"extensions",
		"src",
		"screenshots",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "tsc --noEmit && oxlint",
		"dev": "pi -e ./extensions/zen.ts",
		"lint": "oxlint",
		"pack:check": "pnpm pack --dry-run",
		"prepublishOnly": "pnpm check && pnpm pack:check"
	},
	"pi": {
		"extensions": [
			"./extensions/zen.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.4",
		"@earendil-works/pi-tui": ">=1.0.4"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4",
		"@oxlint/plugins": "^1.83.0",
		"@types/node": "^26.6.1",
		"oxlint": "^1.83.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
